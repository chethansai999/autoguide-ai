# Copy to .env and fill in. .env is git-ignored: NEVER commit real keys.

# ---- LLM -----------------------------------------------------------------
# auto = openai if OPENAI_API_KEY is set, else anthropic, else gemini, else mock (offline)
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# Google Gemini (key from aistudio.google.com; set LLM_PROVIDER=gemini to use it)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# USD per 1M tokens for the cost-per-query metric: set to YOUR model's price
# (defaults are gpt-4o-mini; verify current pricing)
LLM_PRICE_INPUT_PER_MTOK=0.15
LLM_PRICE_OUTPUT_PER_MTOK=0.60
# Retries for transient network errors (DNS blips, dropped connections)
LLM_MAX_RETRIES=2
# Broken network: treat a host as down if DNS takes longer than this, and
# skip it for the cool-down (applies to the LLM and the NHTSA Recalls API)
NET_DNS_TIMEOUT_S=4
NET_UNREACHABLE_COOLDOWN_S=60
# If the LLM can't be reached, show the matching source data with a note
# instead of an error. Bad keys and quota errors are never hidden.
LLM_FALLBACK_ON_CONNECTION_ERROR=true

# ---- Clarifier NLU ---------------------------------------------------------
# rules (baseline) | hf (fine-tuned DistilBERT in models/clarifier) | llm
NLU_BACKEND=rules
# With NLU_BACKEND=llm: your OpenAI fine-tune id from finetune/openai_finetune.py
NLU_LLM_MODEL=

# ---- Retrieval -------------------------------------------------------------
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_BACKEND=cross-encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# fixed until WP-03 ships structure-aware chunking; B3 uses structure
CHUNK_STRATEGY=fixed
CHUNK_VERSION=v1
RETRIEVAL_MODE=hybrid
CANDIDATE_K=20
FINAL_K=5
MIN_RERANK_SCORE=-2.0
MIN_DENSE_SCORE=0.30

# ---- Storage ---------------------------------------------------------------
# Default SQLite file needs no setup. docker-compose sets a Postgres URL.
# DATABASE_URL=postgresql+psycopg://autoguide:autoguide@localhost:5432/autoguide
CHROMA_DB_PATH=data/chroma_db
SAFERCAR_CSV=data/structured/Safercar_data.csv

# ---- UI -> API ---------------------------------------------------------------
# Empty = Streamlit runs the backend in-process. Set to use the HTTP API.
AUTOGUIDE_API_URL=

# ---- Ingestion ---------------------------------------------------------------
NHTSA_BASE_URL=https://www.nhtsa.gov
CRAWLER_CONTACT_EMAIL=your_team_email@example.com
ENABLE_LIVE_RECALLS_API=true

# ---- Offline development profile (no key, no model downloads) -----------------
# LLM_PROVIDER=mock
# EMBEDDING_BACKEND=hashing
# RERANKER_BACKEND=none
